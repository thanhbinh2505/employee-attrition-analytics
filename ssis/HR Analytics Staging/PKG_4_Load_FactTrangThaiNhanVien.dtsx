              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select
    MaCH,
    MaBanGhi as MaBanGhiNguon,
    MaNK_Nguon,
    MaNV,
    PhienBan_SCD,
    NgayChotDuLieu,
    NgayNghiViec,
    convert
    (
        int,
        convert(char(8), NgayChotDuLieu, 112)
    ) as KhoaNgayChot,
    case
        when NgayNghiViec is null then null
        else convert
        (
            int,
            convert(char(8), NgayNghiViec, 112)
        )
    end as KhoaNgayNghi,
    Tuoi,
    KhoangCachTuNha,
    SoLuongDuAn,
    SoGioTrungBinhThang,
    LamThemGio,

    DiemDanhGiaHieuSuat,
    DiemHaiLongCongViec,
    DiemHaiLongMoiTruong,
    ThuNhapThang,
    SoNamTaiCongTy,
    SoNamTuLanThangChucCuoi,
    DuocThangChucNamTruoc,
    NghiViecTrongKy

from stg.NhanVienChuanHoa

where TrangThaiChatLuong = 'VALID'
  and PhienBan_SCD is not null;</property>
