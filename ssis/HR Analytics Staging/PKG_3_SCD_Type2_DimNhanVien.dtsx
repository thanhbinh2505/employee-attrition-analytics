      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34266685-A1BB-40F0-9202-670CCAAAEDF2}"
          SQLTask:SqlStatementSource=";with SCD_Nguon as&#xA;(&#xA;    select&#xA;        &#xA;&#x9;MaNV,&#xA;        &#xA;&#x9;PhienBan_SCD,&#xA;&#xA;        &#xA;&#x9;max(NgayHetHieuLuc_SCD) &#x9;as NgayHetHieuLuc_SCD,&#xA;&#xA;        &#xA;&#x9;max&#xA;        (&#xA;            &#xA;&#x9;cast(LaPhienBanHienTai as tinyint)&#xA;        &#xA;&#x9;) as LaPhienBanHienTai&#xA;&#xA;    from PTNhanSu_Staging.stg.NhanVienChuanHoa&#xA;     where&#xA;        &#xA;&#x9;TrangThaiChatLuong = 'VALID'&#xA;       &#xA; &#x9;and PhienBan_SCD is not null&#xA;        &#xA;&#x9;and NgayHetHieuLuc_SCD is not null&#xA;group by&#xA;        MaNV,&#xA;        PhienBan_SCD&#xA;)&#xA;update D&#xA;set&#xA;    &#xA;D.NgayHetHieuLuc = S.NgayHetHieuLuc_SCD,&#xA;&#xA;    &#xA;D.LaHienTai =&#xA;        cast(S.LaPhienBanHienTai as bit),&#xA;&#xA;    D.ThoiGianCapNhat =&#xA;  sysdatetime()&#xA;&#xA;from dw.DimNhanVien D&#xA;inner join SCD_Nguon S&#xA;    &#xA;on D.MaNV = S.MaNV&#xA;    &#xA;and D.PhienBan = S.PhienBan_SCD&#xA;where&#xA;       &#xA;D.NgayHetHieuLuc &lt;&gt; S.NgayHetHieuLuc_SCD&#xA;&#xA;    &#xA;or D.LaHienTai &lt;&gt;&#xA;       &#xA;cast(S.LaPhienBanHienTai as bit);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
