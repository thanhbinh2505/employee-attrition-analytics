            <component
              refId="Package\ThemPhienBanMoi\Nhan Vien SCD"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Nhan Vien SCD"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;with NhanVienSCD as
(
    select
        MaCH,
        MaNV,
        GioiTinh,
        TinhTrangHonNhan,
        PhongBan,
        ChucDanh,
        CapBacCongViec,
        MaBam,
        PhienBan_SCD,
        NgayHieuLuc_SCD,
        NgayHetHieuLuc_SCD,
        LaPhienBanHienTai,
        row_number() over
        (
            partition by
                MaNV,
                PhienBan_SCD
            order by
                NgayChotDuLieu desc,
                MaCH desc
        ) as RN
    from stg.NhanVienChuanHoa
    where
        TrangThaiChatLuong = 'VALID'
        and PhienBan_SCD is not null
        and NgayHieuLuc_SCD is not null
        and NgayHetHieuLuc_SCD is not null
        and MaBam is not null
)
select
    MaNV,
    GioiTinh,
    TinhTrangHonNhan,
    PhongBan,
    ChucDanh,
    CapBacCongViec,
    NgayHieuLuc_SCD,
    NgayHetHieuLuc_SCD,
    LaPhienBanHienTai,
    PhienBan_SCD,
    MaBam
from NhanVienSCD
where RN = 1;</property>
