      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{79087D8D-79D8-4D3A-9C3F-6C50E9B5C746}"
          SQLTask:SqlStatementSource="UPDATE nk&#xA;&#xA;SET&#xA;    &#xA;SoDongHopLe =&#xA;    (&#xA;      &#xA;SELECT COUNT(*)&#xA;        &#xA;FROM stg.NhanVienChuanHoa AS ch&#xA;        &#xA;WHERE ch.MaNK = nk.MaNK&#xA;    ),&#xA;&#xA;    &#xA;SoDongLoi =&#xA;    (&#xA;       &#xA; SELECT COUNT(*)&#xA;        &#xA;FROM etl.LoiXuLy AS lx&#xA;        &#xA;WHERE lx.MaNK = nk.MaNK&#xA;    ),&#xA;&#xA;   &#xA; TrangThai = 'SUCCESS',&#xA;    &#xA;ThoiGianKetThuc = SYSDATETIME(),&#xA;    &#xA;ThongBaoLoi = NULL&#xA;&#xA;FROM etl.NhatKyTaiDuLieu AS nk&#xA;&#xA;WHERE nk.MaNK = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::MaNK"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Cập nhật xử lý"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{151CE0AE-CE73-463A-AAEE-DD1C710622E8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cập nhật xử lý"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{79087D8D-79D8-4D3A-9C3F-6C50E9B5C746}"
          SQLTask:SqlStatementSource="update stg.DuLieuTho_NV&#xA;&#xA;set DaXuLy = 1&#xA;&#xA;where MaNK = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::MaNK"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\MaNK Xử Lý"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A4C92986-0388-40F1-837E-7237E9FD07E6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="MaNK Xử Lý"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{79087D8D-79D8-4D3A-9C3F-6C50E9B5C746}"
          SQLTask:SqlStatementSource="select isnull((select top 1 MaNK&#xA;from stg.DuLieuTho_NV&#xA;where DaXuLy = 0&#xA;group by MaNK&#xA;order by MaNK),0) as MaNK"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::MaNK" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Tính SCD"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1CC3B626-766B-47F9-BD13-302286960B0D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tính SCD"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{79087D8D-79D8-4D3A-9C3F-6C50E9B5C746}"
          SQLTask:SqlStatementSource=";WITH SoSanhMaBam AS (&#xA; &#xA;SELECT &#xA;        MaCH, MaNV, NgayBatDauNguon, MaBam,&#xA;        &#x9;LAG(MaBam) OVER &#xA;&#x9;(PARTITION BY MaNV &#xA;&#x9;ORDER BY NgayBatDauNguon, MaCH) AS &#x9;MaBamTruoc&#xA;    &#xA;FROM stg.NhanVienChuanHoa&#xA;    &#xA;WHERE TrangThaiChatLuong = 'VALID' AND MaBam IS NOT NULL&#xA;),&#xA;&#xA;DanhDauThayDoi AS (&#xA;  &#xA;SELECT &#xA;        MaCH, MaNV, NgayBatDauNguon,&#xA;        &#xA;&#x9;CASE WHEN MaBamTruoc IS NULL OR MaBam &lt;&gt; MaBamTruoc &#xA;&#x9;THEN 1 ELSE 0 END AS CoThayDoi&#xA;    &#xA;FROM SoSanhMaBam&#xA;&#xA;),&#xA;&#xA;TaoPhienBan AS (&#xA;    &#xA; SELECT &#xA;        MaCH,&#xA;        &#xA;&#x9;SUM(CoThayDoi) OVER &#xA;&#x9;(PARTITION BY MaNV ORDER BY NgayBatDauNguon, MaCH) AS PhienBanMoi&#xA;    &#xA;FROM DanhDauThayDoi&#xA;&#xA;)&#xA;&#xA;UPDATE S&#xA;SET S.PhienBan_SCD = P.PhienBanMoi&#xA;&#xA;FROM stg.NhanVienChuanHoa S&#xA;&#xA;INNER JOIN TaoPhienBan P &#xA;ON S.MaCH = P.MaCH;&#xA;&#xA;;WITH NgayBatDauCuaPhienBan AS (&#xA;    &#xA;SELECT &#xA;        MaNV, &#xA;        PhienBan_SCD,&#xA;        &#xA;MIN(NgayBatDauNguon) AS NgayHieuLuc&#xA;    &#xA;FROM stg.NhanVienChuanHoa&#xA;   &#xA; WHERE TrangThaiChatLuong = 'VALID' AND PhienBan_SCD IS NOT NULL&#xA;    &#xA;GROUP BY MaNV, PhienBan_SCD&#xA;&#xA;),&#xA;NgayCuaPhienBanTiepTheo AS (&#xA;   &#xA;SELECT &#xA;        MaNV, &#xA;        PhienBan_SCD, &#xA;        NgayHieuLuc,&#xA;        LEAD(NgayHieuLuc) OVER (PARTITION BY MaNV ORDER BY PhienBan_SCD) AS NgayHieuLucPhienSau&#xA;    &#xA;FROM NgayBatDauCuaPhienBan&#xA;&#xA;)&#xA;&#xA;UPDATE S&#xA;&#xA;SET &#xA;    S.NgayHieuLuc_SCD = K.NgayHieuLuc,&#xA;S.NgayHetHieuLuc_SCD = ISNULL(DATEADD(day, -1, K.NgayHieuLucPhienSau), '9999-12-31'),&#xA;S.LaPhienBanHienTai = CASE WHEN K.NgayHieuLucPhienSau IS NULL THEN 1 ELSE 0 END&#xA;FROM stg.NhanVienChuanHoa S&#xA;&#xA;INNER JOIN NgayCuaPhienBanTiepTheo K &#xA;    &#xA;ON S.MaNV = K.MaNV &#xA;AND S.PhienBan_SCD = K.PhienBan_SCD;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::MaNK"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Tạo mã băm SCD"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A678772F-4B17-48BA-8D29-491174DFE9F7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tạo mã băm SCD"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{79087D8D-79D8-4D3A-9C3F-6C50E9B5C746}"
          SQLTask:SqlStatementSource="update stg.NhanVienChuanHoa&#xA;set MaBam = HASHBYTES(&#xA;    'SHA2_256',&#xA;    CONCAT(&#xA;        isnull(ltrim(rtrim(GioiTinh)), ''),&#xA;        '|',&#xA;        isnull(ltrim(rtrim(TinhTrangHonNhan)), ''),&#xA;        '|',&#xA;        isnull(ltrim(rtrim(PhongBan)), ''),&#xA;        '|',&#xA;        isnull(ltrim(rtrim(ChucDanh)), ''),&#xA;        '|',&#xA;        convert(varchar(10), CapBacCongViec)&#xA;    )&#xA;)&#xA;where MaNK = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::MaNK"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
