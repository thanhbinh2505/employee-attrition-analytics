  <MdxScripts>
    <MdxScript dwd:design-time-name="4aa5a01a-c24a-4daf-8dc6-a3cd04b901d1">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;     
CREATE MEMBER CURRENTCUBE.[Measures].TongNhanVien
 AS COUNT(
    NONEMPTY(
        [Dim Nhan Vien].[Ma NV].[Ma NV].MEMBERS,
        [Measures].[So Nhan Vien]
    )
), 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].SoNhanVienNghiViec
 AS COUNT(
    FILTER(
        EXISTING [Dim Nhan Vien].[Ma NV].[Ma NV].MEMBERS,
        [Measures].[So Nghi Viec] &gt; 0
    )
), 
VISIBLE = 1;          
CREATE MEMBER CURRENTCUBE.[Measures].TuoiTrungBinh
 AS IIF(
    [Measures].[So Nhan Vien] = 0,
    NULL,
    [Measures].[Tuoi]
    /
    [Measures].[So Nhan Vien]
), 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].DiemNguyCoTrungBinh
 AS IIF(
    [Measures].[So Ban Ghi Du Bao] = 0,
    NULL,
    1.0
    * [Measures].[Tong Diem Nguy Co]
    / [Measures].[So Ban Ghi Du Bao]
),
FORMAT_STRING = "0.00",
VISIBLE = 1, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNhanVienRuiRoCao
 AS IIF(
    [Measures].[So Ban Ghi Du Bao] = 0,
    NULL,
    1.0
    * [Measures].[So Nhan Vien Rui Ro Cao]
    / [Measures].[So Ban Ghi Du Bao]
),
FORMAT_STRING = "0.00%",
VISIBLE = 1, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Trang Thai Nhan Vien'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNhanVienTheoMucRuiRo
 AS IIF(
    [Dim Muc Rui Ro].[Muc Rui Ro].CurrentMember
        IS
    [Dim Muc Rui Ro].[Muc Rui Ro].DefaultMember,

    NULL,

    IIF(
        (
            [Measures].[So Ban Ghi Du Bao],
            [Dim Muc Rui Ro].[Muc Rui Ro].DefaultMember
        ) = 0,

        NULL,

        1.0
        * [Measures].[So Ban Ghi Du Bao]
        /
        (
            [Measures].[So Ban Ghi Du Bao],
            [Dim Muc Rui Ro].[Muc Rui Ro].DefaultMember
        )
    )
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].PrecisionDuBao
 AS IIF(
    (
        [Measures].[True Positive]
        +
        [Measures].[False Positive]
    ) = 0,
    NULL,
    1.0
    * [Measures].[True Positive]
    /
    (
        [Measures].[True Positive]
        +
        [Measures].[False Positive]
    )
),
FORMAT_STRING = "0.00%",
VISIBLE = 1, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].RecallDuBao
 AS IIF(
    (
        [Measures].[True Positive]
        +
        [Measures].[False Negative]
    ) = 0,
    NULL,
    1.0
    * [Measures].[True Positive]
    /
    (
        [Measures].[True Positive]
        +
        [Measures].[False Negative]
    )
),
FORMAT_STRING = "0.00%",
VISIBLE = 1, 
VISIBLE = 1  ;          
CREATE MEMBER CURRENTCUBE.[Measures].ThuNhapTrungBinh
 AS IIF(
    [Measures].[So Nhan Vien] = 0,
    NULL,
    [Measures].[Thu Nhap Thang]
    /
    [Measures].[So Nhan Vien]
), 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNghiViecThucTeDuBao
 AS IIF(
    [Measures].[So Ban Ghi Du Bao] = 0,
    NULL,
    1.0
    * [Measures].[So Nghi Viec Thuc Te]
    / [Measures].[So Ban Ghi Du Bao]
),
FORMAT_STRING = "0.00%",
VISIBLE = 1, 
VISIBLE = 1  ;       
CREATE MEMBER CURRENTCUBE.[Measures].TylenghiviecSnap
 AS IIF(
    [Measures].[So Nhan Vien] = 0,
    NULL,
    1.0 * [Measures].[So Nghi Viec]
        / [Measures].[So Nhan Vien]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNVNghiViec
 AS IIF(
    [Measures].[TongNhanVien] = 0,
    NULL,
    1.0 *
    [Measures].[SoNhanVienNghiViec]
    /
    [Measures].[TongNhanVien]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].SoDuAnTrungBinh
 AS IIF(
    [Measures].[So Nhan Vien] = 0,
    NULL,

    1.0 *
    [Measures].[So Luong Du An]
    /
    [Measures].[So Nhan Vien]
),
FORMAT_STRING = "0.00",
VISIBLE = 1, 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNghiViecNam
 AS IIF(
    [Measures].[TongNhanVien] = 0,
    NULL,

    1.0 *
    [Measures].[SoNhanVienNghiViec]
    /
    [Measures].[TongNhanVien]
),
FORMAT_STRING = "Percent",
VISIBLE = 0, 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].TyLeNghiViecTrungBinhNam
 AS AVG(
    EXISTING
        [Khoa Ngay Chot].[Nam].[Nam].MEMBERS,

    [Measures].[TyLeNghiViecNam]
),
FORMAT_STRING = "Percent",
VISIBLE = 1, 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].SoGioLamTrungBinh
 AS IIF(
    [Measures].[So Nhan Vien] = 0,
    NULL,

    1.0 *
    [Measures].[So Gio Trung Binh Thang]
    /
    [Measures].[So Nhan Vien]
),
FORMAT_STRING = "0.00",
VISIBLE = 1, 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>